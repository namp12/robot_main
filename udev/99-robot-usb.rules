# Udev rules for Autonomous Delivery Robot (ROS 2 Humble / Jazzy on Ubuntu)
# Place in /etc/udev/rules.d/99-robot-usb.rules

# 1. RPLidar C1 / A1 / A2 / A3 / S1 / S2 / S3 (Silicon Labs CP210x USB UART)
# Creates symlink /dev/rplidar -> /dev/ttyUSBx with full read/write permissions
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", GROUP="dialout", SYMLINK+="rplidar"

# 2. ESP32 DevKit (CH340 / CH341 USB-to-UART)
# Creates symlink /dev/esp32 -> /dev/ttyUSBx with full read/write permissions
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", GROUP="dialout", SYMLINK+="esp32"
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="5523", MODE="0666", GROUP="dialout", SYMLINK+="esp32"

# 3. ESP32-S2 / ESP32-S3 / ESP32-C3 Native USB CDC (ACM)
# Creates symlink /dev/esp32 -> /dev/ttyACMx
KERNEL=="ttyACM*", ATTRS{idVendor}=="303a", MODE="0666", GROUP="dialout", SYMLINK+="esp32"

# 4. FTDI FT232R USB-to-UART
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666", GROUP="dialout", SYMLINK+="esp32_ftdi"

# 5. Generic permissions for all ttyUSB and ttyACM devices
KERNEL=="ttyUSB[0-9]*", MODE="0666", GROUP="dialout"
KERNEL=="ttyACM[0-9]*", MODE="0666", GROUP="dialout"
KERNEL=="video[0-9]*", MODE="0666", GROUP="video"
